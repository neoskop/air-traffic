{
  "manifest_version": 3,
  "name": "Air Traffic",
  "description": "Links aus Safari mit Air Traffic öffnen – per Rechtsklick oder Symbolleisten-Knopf. Dann greifen deine Regeln.",
  "version": "1.0",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Mit Air Traffic öffnen",
    "default_icon": "toolbar-icon.svg"
  },
  "permissions": ["contextMenus", "activeTab", "nativeMessaging"]
}
